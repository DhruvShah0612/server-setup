project_name = "ovulation-tracker"
environment  = "dev"
aws_region   = "ap-south-1"

instance_type        = "t3.micro"
ec2_root_volume_size = 30

db_instance_class = "db.t3.micro"
db_storage_size   = 20
db_engine_version = "8.4.11"
db_name           = "appdb"
db_username       = "appadmin"

# IMPORTANT: Replace these with trusted IP ranges before applying.
# Example: ["203.0.113.10/32"]
ssh_allowed_cidrs = ["0.0.0.0/0"]
app_allowed_cidrs = ["0.0.0.0/0"]

# Requested behavior, but strongly not recommended for production.
# Prefer the EC2 security group as the only source for RDS ingress.
rds_allowed_cidrs = ["0.0.0.0/0"]

# S3 bucket names are globally unique. If the default name is unavailable,
# set a suffix such as "team42" to produce ovulation-tracker-dev-team42.
s3_bucket_suffix = ""

secret_recovery_window_days = 7
